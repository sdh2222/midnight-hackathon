{
  "name": "@midnight-hackathon/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy:zk": "node scripts/copy-zk-assets.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "predev": "npm run fonts && npm run copy:zk",
    "prebuild": "npm run build --workspace @midnight-hackathon/shared",
    "build": "npm run fonts && npm run copy:zk && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "pretypecheck": "npm run build --workspace @midnight-hackathon/shared",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "pretest": "npm run build --workspace @midnight-hackathon/shared",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnight-hackathon/intent-contract": "0.1.0",
    "@midnight-hackathon/shared": "0.1.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@privy-io/react-auth": "^3.45.0",
    "buffer": "^6.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^5.0.2"
  }
}
