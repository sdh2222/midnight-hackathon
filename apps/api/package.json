{
  "name": "@midnight-hackathon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "prebuild": "npm run build --workspace @midnight-hackathon/shared",
    "build": "tsc -p tsconfig.json",
    "predev": "npm run build --workspace @midnight-hackathon/shared",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "pretypecheck": "npm run build --workspace @midnight-hackathon/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --workspace @midnight-hackathon/shared",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnight-hackathon/shared": "0.1.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
