# Midnight Preprod (public test network closest to mainnet).
# Copy to .env.preprod. Never commit the copy.
#
#   cp .env.preprod.example .env.preprod
#
# Faucet: https://faucet.preprod.midnight.network/
# Proof server stays local — it sees witness data in the clear.

MIDNIGHT_NETWORK=preprod
MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
PROOF_SERVER_URL=http://127.0.0.1:6300

# Set exactly one. Delete the other line.
# MIDNIGHT_PREPROD_MNEMONIC=
# MIDNIGHT_PREPROD_SEED=

# CONTRACT_ADDRESS=
