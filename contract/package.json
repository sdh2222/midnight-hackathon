{
  "name": "@midnight-hackathon/intent-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./simulator": "./src/test/simulator.ts"
  },
  "scripts": {
    "compact": "node scripts/compile.mjs",
    "compact:zk": "node scripts/compile.mjs --zk",
