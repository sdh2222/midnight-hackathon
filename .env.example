# Local Midnight network (undeployed).
# Copy to .env and fill secrets locally. Never commit the copy.
#
#   cp .env.example .env
#
# Node 22+, Docker Desktop, and a local proof server on :6300.
# Docs: https://docs.midnight.network/guides/midnight-local-network

MIDNIGHT_NETWORK=undeployed
MIDNIGHT_NODE_URL=http://localhost:9944
MIDNIGHT_INDEXER_URL=http://localhost:8088/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=ws://localhost:8088/api/v4/graphql/ws
PROOF_SERVER_URL=http://127.0.0.1:6300

# Set exactly one. Delete the other line.
# 24-word phrase:
# MIDNIGHT_MNEMONIC=
# or 64-char hex seed, no 0x prefix:
# MIDNIGHT_SEED=

# Optional: deployed contract address after first deploy
# CONTRACT_ADDRESS=

# Application API. Privy App ID is public; Reef/Jev keys stay server-side.
API_PORT=3001
PRIVY_APP_ID=
# 32-byte key, 64 hex characters. Seals per-user Midnight seeds at rest.
# Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=
# Optional. Defaults to apps/api/data/wallets.json.
# WALLET_STORE_PATH=
CATALOG_PROVIDER=reef
REEF_API_KEY=
# Optional. Defaults to apps/api/data/executions.json.
# EXECUTION_STORE_PATH=
ORDER_PROVIDER=mock
ORDER_MAX_RETRIES=2
ORDER_RETRY_BASE_MS=100

# Set CATALOG_PROVIDER=mock for offline search. Orders are still mocked.
JEV_PROVIDER=typesafe
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=30000
JEV_MAX_RETRIES=2
JEV_MIN_CONFIDENCE=0.65

# Browser Midnight integration. Use lace after compact:zk and a local deployment.
VITE_API_BASE_URL=
VITE_PRIVY_APP_ID=
# Optional. Read access to the private fonts repo. Without it, the UI uses system-ui.
# FONTS_TOKEN=
# FONTS_REPO=sdh2222/fonts
VITE_MIDNIGHT_MODE=demo
VITE_NETWORK_ID=undeployed
VITE_CONTRACT_ADDRESS=
