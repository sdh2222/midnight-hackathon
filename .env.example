# Local Midnight network (undeployed).
# Copy to .env and fill secrets locally. Never commit the copy.
#
#   cp .env.example .env
#
# Node 22+, Docker Desktop, and a local proof server on :6300.
# Docs: https://docs.midnight.network/guides/midnight-local-network

MIDNIGHT_NETWORK=undeployed
MIDNIGHT_NODE_URL=http://localhost:9944
MIDNIGHT_INDEXER_URL=http://localhost:8088/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=ws://localhost:8088/api/v4/graphql/ws
PROOF_SERVER_URL=http://127.0.0.1:6300

# Set exactly one. Delete the other line.
# 24-word phrase:
# MIDNIGHT_MNEMONIC=
# or 64-char hex seed, no 0x prefix:
# MIDNIGHT_SEED=

# Optional: deployed contract address after first deploy
# CONTRACT_ADDRESS=
